rules_version = '2';

// Pot of Gold: who can read and change what.
// - Organisers (emails in config/admins) can change everything.
// - Golfers sign in with the email the organiser saved for them (members/{email}),
//   or ask to join (requests/{email}) and wait for an organiser to let them in.
// - Entry fees are paid through Revolut. Golfers can say they've paid; organisers confirm it.
// - Players tap Start my round before teeing off (Fri-Sun), then enter their card by midnight that day,
//   with their marker's name and a tick to say the paper card is signed. Complete, signed cards count.
// - New cards are played off the golfer's current competition handicap (golfers/{id}.hcp, kept up to date by the organiser's app).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminsPath() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() { return verified() && exists(adminsPath()) && myEmail() in get(adminsPath()).data.emails; }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isMember() { return verified() && exists(memberPath()); }
    function myGid() { return get(memberPath()).data.golferId; }
    function canRead() { return isAdmin() || isMember(); }

    // Organiser list. The first person to set up the app can make themselves organiser.
    match /config/admins {
      allow read: if signedIn();
      allow create: if verified() && request.resource.data.emails == [myEmail()];
      allow update, delete: if isAdmin();
    }

    // Admin page code (stored as a salted hash).
    match /config/admin {
      allow read, write: if isAdmin();
    }

    // Entry fee, Revolut link, prizes, points, course card.
    match /config/settings {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    // Which email belongs to which golfer. Golfers can only look up their own.
    match /members/{email} {
      allow get: if verified() && email == myEmail();
      allow read, write: if isAdmin();
    }

    // Requests to join from people whose email isn't on the golfer list yet.
    // They can send or cancel their own; organisers see them all and let people in.
    match /requests/{email} {
      allow get, delete: if verified() && email == myEmail();
      allow create, update: if verified() && email == myEmail()
        && request.resource.data.keys().hasOnly(['name', 'hi', 'gender', 'email', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 60
        && request.resource.data.email == myEmail()
        && request.resource.data.gender in ['M', 'L']
        && (request.resource.data.get('hi', null) == null || request.resource.data.hi is number);
      allow read, write: if isAdmin();
    }

    match /golfers/{gid} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /comps/{cid} {
      function comp() { return get(/databases/$(database)/documents/comps/$(cid)).data; }
      function isOpen() { return comp().status == 'open'; }
      function roundOpen(n) {
        let r = comp().rounds[n - 1];
        return request.time >= r.opens && request.time < r.closes;
      }
      function entered(gid) { return exists(/databases/$(database)/documents/comps/$(cid)/entries/$(gid)); }

      allow read: if canRead();
      allow write: if isAdmin();

      // One entry per golfer per month. Golfers can enter themselves (unpaid) and say they've paid;
      // only organisers mark an entry as paid.
      match /entries/{gid} {
        allow read: if canRead();
        allow write: if isAdmin();
        allow create: if isMember() && gid == myGid() && isOpen()
          && request.resource.data.keys().hasOnly(['compId', 'golferId', 'paid', 'method', 'paidAt', 'createdAt', 'claimed', 'claimMethod', 'claimedAt'])
          && request.resource.data.compId == cid
          && request.resource.data.golferId == gid
          && request.resource.data.paid == false;
        allow update: if isMember() && gid == myGid() && isOpen()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimMethod', 'claimedAt'])
          && request.resource.data.claimed is bool
          && request.resource.data.get('claimMethod', null) in [null, 'revolut', 'card'];
      }

      // 2's club: one per golfer per round (id = "<round>_<golferId>"). Open to any golfer on the list, whether or not
      // they're in the month (a 2's-only player's card is marked twosOnly and never counts for the month). Nobody is in without paying, and it's paid
      // before teeing off: a golfer joins and says they've paid while the round is open, before starting it or within
      // 10 minutes of starting. Only organisers mark it paid.
      match /twos/{tid} {
        function startedNow(n) {
          let p = /databases/$(database)/documents/comps/$(cid)/cards/$(string(n) + '_' + myGid());
          return !existsAfter(p) || getAfter(p).data.startedAt > request.time.toMillis() - 600000;
        }
        allow read: if canRead();
        allow write: if isAdmin();
        allow create: if isMember() && isOpen()
          && request.resource.data.keys().hasOnly(['compId', 'golferId', 'round', 'paid', 'method', 'paidAt', 'createdAt', 'claimed', 'claimMethod', 'claimedAt'])
          && request.resource.data.compId == cid
          && request.resource.data.golferId == myGid()
          && request.resource.data.round is int
          && tid == string(request.resource.data.round) + '_' + myGid()
          && request.resource.data.paid == false
          && roundOpen(request.resource.data.round)
          && request.resource.data.createdAt is int
          && math.abs(request.resource.data.createdAt - request.time.toMillis()) < 600000
          && startedNow(request.resource.data.round);
        allow update: if isMember() && resource.data.golferId == myGid() && isOpen()
          && roundOpen(resource.data.round) && startedNow(resource.data.round)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['claimed', 'claimMethod', 'claimedAt'])
          && request.resource.data.claimed is bool
          && request.resource.data.get('claimMethod', null) in [null, 'revolut', 'card'];
      }

      // Cards: one per golfer per round (id = "<round>_<golferId>").
      // The player starts their card before teeing off (startedAt), and has until the deadline
      // (midnight that day) to enter it, add their marker's name and tick that the paper card is signed.
      // After the deadline the card is locked. Organisers can change or delete any card.
      match /cards/{cardId} {
        function ownCard(c) {
          let me = myGid();
          let golfer = get(/databases/$(database)/documents/golfers/$(c.golferId)).data;
          let now = request.time.toMillis();
          let inTwos = existsAfter(/databases/$(database)/documents/comps/$(cid)/twos/$(cardId));
          return c.keys().hasOnly(['compId', 'golferId', 'round', 'marker', 'signed', 'scores', 'hi', 'shots', 'updatedAt', 'updatedBy', 'scanned', 'startedAt', 'deadline', 'twosOnly'])
            && c.compId == cid && c.round is int && c.scores is map
            && cardId == string(c.round) + '_' + c.golferId
            && c.golferId == me && (entered(me) || inTwos)
            && c.marker is string && c.marker.size() <= 60 && c.signed is bool
            && c.startedAt is int && c.deadline is int
            && isOpen() && roundOpen(c.round)
            && (resource == null
                  ? (c.shots == null && c.hi == golfer.get('hcp', golfer.get('hi', null))
                     && c.get('twosOnly', false) == !entered(me)
                     && math.abs(c.startedAt - now) < 600000
                     && c.deadline > now && c.deadline <= now + 86400000)
                  : (resource.data.golferId == c.golferId && resource.data.round == c.round
                     && c.shots == resource.data.get('shots', null) && c.hi == resource.data.get('hi', null)
                     && c.startedAt == resource.data.get('startedAt', null) && c.deadline == resource.data.get('deadline', null)
                     && c.get('twosOnly', false) == resource.data.get('twosOnly', false)
                     && now < resource.data.deadline));
        }
        allow read: if canRead();
        allow write: if isAdmin();
        allow create, update: if isMember() && ownCard(request.resource.data);
      }
    }

    // Reading across all competitions (league table and stats).
    match /{path=**}/entries/{gid} { allow read: if canRead(); }
    match /{path=**}/cards/{cardId} { allow read: if canRead(); }
    match /{path=**}/twos/{tid} { allow read: if canRead(); }
  }
}
