rules_version = '2';

// Rathsallagh Monthly: who can read and change what.
// - Organisers (emails in config/admins) can change everything.
// - Golfers sign in with the email the organiser saved for them (members/{email}).
// - Players enter their own card while the round is open (Fri-Sun) and choose a marker: another player entered that month.
// - The card only counts once that marker approves it. Any change by the player resets the approval.
// - New cards are played off the golfer's current competition handicap (golfers/{id}.hcp, kept up to date by the organiser's app).
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function verified() { return signedIn() && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function adminsPath() { return /databases/$(database)/documents/config/admins; }
    function isAdmin() { return verified() && exists(adminsPath()) && myEmail() in get(adminsPath()).data.emails; }
    function memberPath() { return /databases/$(database)/documents/members/$(myEmail()); }
    function isMember() { return verified() && exists(memberPath()); }
    function myGid() { return get(memberPath()).data.golferId; }
    function canRead() { return isAdmin() || isMember(); }

    // Organiser list. The first person to set up the app can make themselves organiser.
    match /config/admins {
      allow read: if signedIn();
      allow create: if verified() && request.resource.data.emails == [myEmail()];
      allow update, delete: if isAdmin();
    }

    // Admin page code (stored as a salted hash).
    match /config/admin {
      allow read, write: if isAdmin();
    }

    // Entry fee, Revolut link, prizes, points, course card.
    match /config/settings {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    // Which email belongs to which golfer. Golfers can only look up their own.
    match /members/{email} {
      allow get: if verified() && email == myEmail();
      allow read, write: if isAdmin();
    }

    match /golfers/{gid} {
      allow read: if canRead();
      allow write: if isAdmin();
    }

    match /comps/{cid} {
      function comp() { return get(/databases/$(database)/documents/comps/$(cid)).data; }
      function isOpen() { return comp().status == 'open'; }
      function roundOpen(n) {
        let r = comp().rounds[n - 1];
        return request.time >= r.opens && request.time < r.closes;
      }
      function entered(gid) { return exists(/databases/$(database)/documents/comps/$(cid)/entries/$(gid)); }

      allow read: if canRead();
      allow write: if isAdmin();

      // One entry per golfer per month. Golfers can enter themselves (unpaid); organisers record payments.
      match /entries/{gid} {
        allow read: if canRead();
        allow write: if isAdmin();
        allow create: if isMember() && gid == myGid() && isOpen()
          && request.resource.data.keys().hasOnly(['compId', 'golferId', 'paid', 'method', 'paidAt', 'createdAt'])
          && request.resource.data.compId == cid
          && request.resource.data.golferId == gid
          && request.resource.data.paid == false;
      }

      // Cards: one per golfer per round (id = "<round>_<golferId>").
      // The player enters their own card and names a marker; only that marker can approve it.
      match /cards/{cardId} {
        function ownCard(c) {
          let me = myGid();
          let golfer = get(/databases/$(database)/documents/golfers/$(c.golferId)).data;
          return c.keys().hasOnly(['compId', 'golferId', 'round', 'groupId', 'markerId', 'scores', 'hi', 'shots', 'approved', 'approvedBy', 'approvedAt', 'updatedAt', 'updatedBy', 'scanned'])
            && c.compId == cid && c.round is int && c.scores is map
            && cardId == string(c.round) + '_' + c.golferId
            && c.golferId == me && c.markerId is string && c.markerId != me
            && entered(me) && entered(c.markerId)
            && c.approved == false && c.get('approvedBy', null) == null
            && isOpen() && roundOpen(c.round)
            && (resource == null
                  ? (c.shots == null && c.hi == golfer.get('hcp', golfer.get('hi', null)))
                  : (resource.data.golferId == c.golferId && resource.data.round == c.round
                     && c.shots == resource.data.get('shots', null) && c.hi == resource.data.get('hi', null)));
        }
        function approval(c) {
          let me = myGid();
          return resource != null && resource.data.markerId == me && resource.data.golferId != me
            && c.diff(resource.data).affectedKeys().hasOnly(['approved', 'approvedBy', 'approvedAt'])
            && c.approved == true && c.approvedBy == me && isOpen();
        }
        allow read: if canRead();
        allow write: if isAdmin();
        allow create: if isMember() && ownCard(request.resource.data);
        allow update: if isMember() && (ownCard(request.resource.data) || approval(request.resource.data));
      }
    }

    // Reading across all competitions (league table and stats).
    match /{path=**}/entries/{gid} { allow read: if canRead(); }
    match /{path=**}/cards/{cardId} { allow read: if canRead(); }
  }
}
